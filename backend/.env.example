# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/nara_ac

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_CONFIDENCE_THRESHOLD=0.55
AI_TIMEOUT_MS=6000

# Other Services
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SCHEDULER_ENABLED=true
# Wajib diisi dengan password yang kuat. Jangan gunakan nilai default di production.
# Contoh: DEMO_PASSWORD=PasswordKuat#2026
DEMO_PASSWORD=

# Google Gemini AI Configuration (Opsional untuk jawaban informatif cerdas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
