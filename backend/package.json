{
  "name": "nara-ac-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API /api/v1 untuk Sistem Pengelolaan Jadwal & Pengingat Service AC (A26-CS054)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:dummy": "node src/db/seedDummy.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "jest --runInBand --forceExit",

    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.0.0",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
